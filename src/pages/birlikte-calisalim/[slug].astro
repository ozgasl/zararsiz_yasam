---
// Birlikte Çalışalım altındaki 3 hizmet sayfası artık panelden düzenlenen
// "hizmetler" koleksiyonundan geliyor. URL'ler değişmedi:
// /birlikte-calisalim/mindfulness-koclugu/, /yin-yoga/, /meditasyon/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const hizmetler = await getCollection("hizmetler", ({ data }) => !data.draft);
  return hizmetler.map((h) => ({ params: { slug: h.slug }, props: { hizmet: h } }));
}

const { hizmet } = Astro.props as { hizmet: any };
const { Content } = await hizmet.render();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${hizmet.data.title} — Zararsız Yaşam`}>

<section class="svc-hero">
  <div class="wrap svc-hero-wrap">
    <a class="txtlink back-link reveal" href={`${base}birlikte-calisalim/`}>← Birlikte Çalışalım</a>
    <p class="eyebrow reveal">Birlikte Çalışalım</p>
    <h1 class="reveal">{hizmet.data.title}</h1>
    <p class="lead reveal">{hizmet.data.lead}</p>
    {hizmet.data.tags.length > 0 && (
      <p class="svc-tags reveal">{hizmet.data.tags.join(" · ")}</p>
    )}
  </div>
</section>

<section style="padding:0 0 50px">
  <div class="wrap" style="max-width:680px">
    <div class="svc-body reveal"><Content /></div>
  </div>
</section>

<section style="padding:0 0 80px">
  <div class="wrap" style="text-align:center">
    <div class="reveal" style="background:var(--sand);border-radius:28px;padding:50px 30px;max-width:640px;margin:0 auto">
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:2.2rem;margin-bottom:16px">Birlikte başlayalım</h2>
      <p style="color:var(--muted);max-width:34em;margin:0 auto 28px;font-size:1.1rem">Soru sormak veya rezervasyon için bana doğrudan yazabilirsiniz.</p>
      <a class="btn btn-primary" href="mailto:ben@meliszararsiz.com">ben@meliszararsiz.com</a>
      <p style="margin-top:20px"><a class="txtlink" href={`${base}birlikte-calisalim/#faq`}>Sık Sorulan Sorular →</a></p>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.svc-hero { padding: 60px 0 60px; }
.svc-hero-wrap { max-width: 800px; }
.back-link { margin-bottom: 24px; display: inline-flex; }
.svc-hero h1 { font-family: "Cormorant Garamond", serif; font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 14px 0 22px; }
.svc-hero .lead { font-size: 1.15rem; color: var(--muted); max-width: 36em; margin-bottom: 18px; }
.svc-tags { color: var(--muted); font-size: .94rem; }
.svc-body { color: var(--ink); font-size: 1.08rem; line-height: 1.8; }
.svc-body p { margin-bottom: 1.2em; }
.svc-body p:last-child { margin-bottom: 0; }
</style>
