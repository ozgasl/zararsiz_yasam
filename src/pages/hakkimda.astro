---
import BaseLayout from "../layouts/BaseLayout.astro";
import { metinler, md, mdSatir, gorsel } from "../site.js";
const base = import.meta.env.BASE_URL;

const h = metinler.hakkimda;
const foto = gorsel(metinler.anasayfa.hero_foto, base);

// İkonlar kodda; panelden yalnızca başlık ve açıklama değişir.
const SERTIFIKA_IKONLARI = [
  '<path d="M12 3v18M5 8c3 0 5 2 7 4M19 8c-3 0-5 2-7 4"/>',
  '<circle cx="12" cy="8" r="3"/><path d="M5 20c1-4 4-6 7-6s6 2 7 6"/>',
  '<path d="M12 4c4 3 4 9 0 16C8 13 8 7 12 4Z"/>',
];
const sertifikalar = SERTIFIKA_IKONLARI.map((ikon, i) => ({ ikon, ...(h.sertifikalar?.[i] ?? {}) }))
  .filter((s) => s.baslik);
---
<BaseLayout title="Merhaba, ben Melis — Zararsız Yaşam">

<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal">
      <p class="eyebrow">{h.ustbaslik}</p>
      <h1>{h.baslik}</h1>
      <p class="lead" set:html={mdSatir(h.lead)}></p>
      <a class="btn btn-primary" href={`${base}birlikte-calisalim/`}>Birlikte Çalışalım →</a>
    </div>
    <div class="hero-media reveal">
      <div class="hero-photo">
        <picture>
          {foto.webpSrcset && <source type="image/webp" srcset={foto.webpSrcset} />}
          <img src={foto.src} srcset={foto.srcset} width={foto.width} height={foto.height} alt={metinler.anasayfa.hero_foto_alt}>
        </picture>
      </div>
    </div>
  </div>
</section>

<section class="bio-sec">
  <div class="wrap bio-wrap">
    <h2 class="reveal">{h.hikaye_baslik}</h2>
    <div class="reveal bio-body" set:html={md(h.hikaye_metin)}></div>
  </div>
</section>

<section class="neden-sec">
  <div class="wrap bio-wrap">
    <p class="eyebrow reveal">{h.neden_ustbaslik}</p>
    <h2 class="reveal">{h.neden_baslik}</h2>
    <div class="reveal bio-body" set:html={md(h.neden_metin)}></div>
  </div>
</section>

<section class="why" style="padding:50px 0 40px">
  <div class="wrap">
    <p class="eyebrow reveal" style="text-align:center">{h.sertifika_ustbaslik}</p>
    <h2 class="reveal">{h.sertifika_baslik}</h2>
    <div class="services">
      {sertifikalar.map((s) => (
        <div class="service reveal">
          <div class="svc-ico" set:html={`<svg viewBox="0 0 24 24">${s.ikon}</svg>`} />
          <h3>{s.baslik}</h3>
          <p set:html={mdSatir(s.aciklama)}></p>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="padding:30px 0 80px">
  <div class="wrap" style="text-align:center">
    <div class="reveal" style="background:var(--sand);border-radius:28px;padding:50px 30px;max-width:640px;margin:0 auto">
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:2.2rem;margin-bottom:16px">Birlikte Çalışalım</h2>
      <p style="color:var(--muted);max-width:34em;margin:0 auto 28px;font-size:1.1rem">Mindfulness temelli koçluk, yoga ya da meditasyon alanlarında ilerlemek isterseniz birlikte çalışabiliriz.</p>
      <a class="btn btn-primary" href={`${base}birlikte-calisalim/`}>İnceleyin ve İletişime Geçin</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.bio-sec { padding: 64px 0 20px; }
.neden-sec { padding: 40px 0 64px; background: var(--cream2); }
.bio-wrap { max-width: 720px; }
.bio-wrap h2 { font-family: "Cormorant Garamond", serif; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 24px; }
.bio-wrap .eyebrow { margin-bottom: 10px; }
.bio-body { color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
.bio-body p { margin-bottom: 1.2em; }
.bio-body p:last-child { margin-bottom: 0; }
.bio-body a { color: var(--wine); text-decoration: underline; text-underline-offset: 3px; }
</style>
