---
import BaseLayout from "../layouts/BaseLayout.astro";
import Duyurular from "../components/Duyurular.astro";
import { metinler, kitapAyarlari, md, mdSatir } from "../site.js";
const base = import.meta.env.BASE_URL;

const k = metinler.kitap;

// Kitap satışa çıkınca panelden "Satışta mı?" açılır; buradaki tüm "Yakında"lar
// tıklanabilir mağaza linklerine döner. Linki girilmemiş mağaza yine "Yakında"
// kalır, yani anahtarı erken açmak sayfayı bozmaz.
const satista = kitapAyarlari.satista_mi === true;
const magazalar = (kitapAyarlari.magazalar ?? []).map((m) => ({
  ad: m.ad,
  link: satista && m.link ? m.link : null,
}));
---
<BaseLayout title="Kabuk — Bir Dönüşüm Hikâyesi — Zararsız Yaşam">

<section class="book" style="padding-top:60px">
  <div class="wrap">
    <div class="book-panel reveal">
      <div class="book-cover">
        <div class="book-badge">Kitap</div>
        <img src={`${base}assets/img/kabuk-kapak.jpg`} alt="Kabuk kitabı kapağı">
      </div>
      <div class="book-body">
        <p class="eyebrow">{k.ustbaslik}</p>
        <h1 class="kitap-h1">{k.baslik}</h1>
        <p set:html={mdSatir(k.tanitim)}></p>
        <div class="book-actions">
          <button type="button" class="btn btn-primary" id="satin-al-btn" aria-haspopup="dialog" aria-controls="satin-al-modal">{kitapAyarlari.satin_al_etiketi}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SATIN AL POPUP -->
<div class="sa-overlay" id="satin-al-modal" role="dialog" aria-modal="true" aria-labelledby="sa-title" hidden>
  <div class="sa-modal">
    <button type="button" class="sa-close" id="satin-al-close" aria-label="Kapat">✕</button>
    <p class="eyebrow" id="sa-title">{kitapAyarlari.popup_baslik}</p>
    <p class="sa-lead">{satista ? kitapAyarlari.popup_metin_satista : kitapAyarlari.popup_metin_satista_degil}</p>
    <div class="sa-stores">
      {magazalar.map((m) => (
        m.link ? (
          <a class="sa-store sa-store-link" href={m.link} target="_blank" rel="noopener">
            <span class="sa-store-name">{m.ad}</span>
            <span class="sa-buy">Satın Al →</span>
          </a>
        ) : (
          <span class="sa-store" aria-disabled="true">
            <span class="sa-store-name">{m.ad}</span>
            <span class="sa-soon">{kitapAyarlari.yakinda_etiketi}</span>
          </span>
        )
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var openBtn = document.getElementById('satin-al-btn');
    var closeBtn = document.getElementById('satin-al-close');
    var modal = document.getElementById('satin-al-modal');
    if (!openBtn || !modal) return;
    function open() { modal.hidden = false; document.body.style.overflow = 'hidden'; }
    function close() { modal.hidden = true; document.body.style.overflow = ''; }
    openBtn.addEventListener('click', open);
    closeBtn && closeBtn.addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
</script>

<section class="kitap-sec">
  <div class="wrap kitap-wrap">
    <p class="eyebrow reveal">{k.arka_plan_ustbaslik}</p>
    <h2 class="reveal">{k.arka_plan_baslik}</h2>
    <div class="reveal bio-body" set:html={md(k.arka_plan_metin)}></div>
  </div>
</section>

<section class="kitap-sec" style="background:var(--cream2)">
  <div class="wrap kitap-wrap">
    <p class="eyebrow reveal">{k.hakkinda_ustbaslik}</p>
    <h2 class="reveal">{k.hakkinda_baslik}</h2>
    <div class="reveal bio-body" set:html={md(k.hakkinda_metin)}></div>
  </div>
</section>

<section class="kitap-sec">
  <div class="wrap kitap-wrap">
    <p class="eyebrow reveal">{k.kimin_ustbaslik}</p>
    <h2 class="reveal">{k.kimin_baslik}</h2>
    <div class="reveal">
      <ul class="kitap-list">
        {(k.kimin_liste ?? []).map((madde) => <li set:html={mdSatir(madde)}></li>)}
      </ul>
    </div>
  </div>
</section>

<!-- DUYURULAR (kayan bant — duyuru yoksa hiç görünmez) -->
<Duyurular variant="page" />

<section style="padding:40px 0 60px">
  <div class="wrap" style="text-align:center">
    <a class="txtlink" href={`${base}bulusmalar/#konuk-konusmacilar`}>Söyleşiler ve İmza Günleri →</a>
  </div>
</section>

<section style="padding:0 0 80px">
  <div class="wrap" style="text-align:center">
    <div class="reveal" style="background:var(--sand);border-radius:28px;padding:50px 30px;max-width:640px;margin:0 auto">
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:2.2rem;margin-bottom:16px">Haberdar Olun</h2>
      <p style="color:var(--muted);max-width:34em;margin:0 auto 28px;font-size:1.1rem">Satış tarihi, söyleşiler ve imza günleri için bültene katılın.</p>
      <a class="btn btn-outline" href="mailto:ben@meliszararsiz.com">Bültene Kaydolun</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.kitap-h1 { font-family: "Cormorant Garamond", serif; font-size: clamp(2.4rem,4vw,3.4rem); margin-bottom: 16px; }
.kitap-sec { padding: 60px 0; }
.kitap-wrap { max-width: 720px; }
.kitap-wrap .eyebrow { margin-bottom: 10px; }
.kitap-wrap h2 { font-family: "Cormorant Garamond", serif; font-size: 2.2rem; margin-bottom: 28px; }
.bio-body { color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
.bio-body p { margin-bottom: 1.2em; }
.bio-body p:last-child { margin-bottom: 0; }
.kitap-list { list-style: none; padding: 0; }
.kitap-list li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 1.1rem; padding-left: 1.2em; position: relative; }
.kitap-list li::before { content: "—"; position: absolute; left: 0; color: var(--wine); }
</style>
