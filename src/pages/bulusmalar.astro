---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../utils.js";
import { metinler, md, mdSatir } from "../site.js";
const base = import.meta.env.BASE_URL;
const b = metinler.bulusmalar;

const ICONS: Record<string, string> = {
  kitap: '<path d="M4 5h16v14H4zM4 9h16"/>',
  yazi: '<path d="M6 4h9l3 3v13H6zM9 12h6M9 16h4"/>',
  sohbet: '<path d="M12 3v18M5 8c3 0 5 2 7 4M19 8c-3 0-5 2-7 4"/>',
  sanat: '<path d="M4 18l5-7 4 5 3-4 4 6zM4 5h16v13H4z"/>',
  ada: '<path d="M3 12h18M12 3a9 9 0 010 18M12 3c-2 2-3 5-3 9s1 7 3 9M12 3c2 2 3 5 3 9s-1 7-3 9"/>',
  mikrofon: '<path d="M12 3a3 3 0 00-3 3v6a3 3 0 006 0V6a3 3 0 00-3-3z"/><path d="M5 11a7 7 0 0014 0M12 18v3"/>',
};

const meetupEntries = (await getCollection("meetups", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Gerçekleşen buluşmalar blog yazısı olarak yazılıyor. Bir buluşmanın
// kategorisinde en az bir yazı varsa kutunun altında o yazılara link çıkar.
const posts = await getCollection("blog", ({ data }) => !data.draft);
const postCountByCategory = new Map<string, number>();
for (const post of posts) {
  for (const cat of post.data.categories ?? []) {
    const key = slugify(cat);
    postCountByCategory.set(key, (postCountByCategory.get(key) ?? 0) + 1);
  }
}

const meetups = await Promise.all(
  meetupEntries.map(async (m) => {
    const { Content } = await m.render();
    const catSlug = m.data.category ? slugify(m.data.category) : null;
    const postCount = catSlug ? postCountByCategory.get(catSlug) ?? 0 : 0;
    const active = m.data.active === true;
    const relatedSlug = catSlug
      ? posts
          .slice()
          .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
          .find((p) => (p.data.categories ?? []).some((c) => slugify(c) === catSlug))?.slug
      : null;
    return {
      slug: m.slug,
      title: m.data.title,
      icon: ICONS[m.data.icon] ?? ICONS.kitap,
      active,
      postCount,
      // Aktifse doğrudan yazının içine git; değilse bu buluşmanın kendi
      // sayfasına (genel açıklama + geçmiş buluşmalar).
      href: active && relatedSlug ? `${base}blog/${relatedSlug}/` : `${base}bulusmalar/${m.slug}/`,
      Content,
    };
  })
);
---
<BaseLayout title="Buluşmalar — Zararsız Yaşam">

<section class="bls-hero">
  <div class="wrap bls-hero-wrap">
    <p class="eyebrow reveal">{b.ustbaslik}</p>
    <h1 class="reveal">{b.baslik}</h1>
    <p class="lead reveal" set:html={mdSatir(b.lead)}></p>
  </div>
</section>

<section class="bls-origin">
  <div class="wrap bio-wrap">
    <h2 class="reveal">{b.dogus_baslik}</h2>
    <div class="reveal bio-body" set:html={md(b.dogus_metin)}></div>
  </div>
</section>

<section class="why" style="padding:60px 0 60px">
  <div class="wrap">
    <p class="eyebrow reveal" style="text-align:center">Etkinlikler</p>
    <h2 class="reveal">Neler Yapıyoruz?</h2>
    <div class="services">
      {meetups.map(({ slug, title, icon, active, postCount, href, Content }) => (
        <div class="service reveal" id={slug}>
          <div class="svc-ico" set:html={`<svg viewBox="0 0 24 24">${icon}</svg>`} />
          <h3>{title} {active && <span class="badge-aktif">Aktif</span>}</h3>
          <div class="svc-text"><Content /></div>
          <a class="txtlink meet-archive" href={href}>
            {active && href.includes("/blog/")
              ? "Etkinliğe git →"
              : postCount > 0
                ? `Gerçekleşen buluşmalar (${postCount}) →`
                : "Buluşma sayfasına git →"}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="padding:0 0 70px">
  <div class="wrap" style="max-width:720px">
    <div class="testi reveal">
      <p class="eyebrow">{b.kimler_ustbaslik}</p>
      <span class="q">&ldquo;</span>
      <blockquote set:html={mdSatir(b.kimler_alinti)}></blockquote>
      <p style="color:#D8D3BE;font-size:1.05rem;margin-top:16px" set:html={mdSatir(b.kimler_not)}></p>
    </div>
  </div>
</section>

<section style="padding:0 0 80px">
  <div class="wrap" style="text-align:center">
    <div class="reveal" style="background:var(--sand);border-radius:28px;padding:50px 30px;max-width:640px;margin:0 auto">
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:2.2rem;margin-bottom:16px">Duyurulardan Haberdar Olun</h2>
      <p style="color:var(--muted);max-width:34em;margin:0 auto 28px;font-size:1.1rem">Yeni buluşmalar için bültene katılın ya da doğrudan yazın.</p>
      <a class="btn btn-primary" href="mailto:ben@meliszararsiz.com">İletişime geçin →</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.bls-hero { padding: 80px 0 60px; }
.bls-hero-wrap { max-width: 800px; }
.bls-hero h1 { font-family: "Cormorant Garamond", serif; font-size: clamp(2.2rem, 4vw, 3.2rem); margin: 14px 0 22px; }
.bls-origin { padding: 40px 0 60px; background: var(--cream2); }
.bio-wrap { max-width: 720px; }
.bio-wrap h2 { font-family: "Cormorant Garamond", serif; font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 24px; }
.bio-body { color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
.bio-body p { margin-bottom: 1.2em; }
.bio-body p:last-child { margin-bottom: 0; }
.why h2 { font-family: "Cormorant Garamond", serif; font-size: clamp(1.8rem,3vw,2.4rem); text-align: center; margin-bottom: 40px; }
.service { scroll-margin-top: 150px; }
.meet-archive { margin-top: 14px; }
.badge-aktif{display:inline-flex;align-items:center;gap:.5em;padding:.35em .9em;border-radius:999px;background:var(--wine);color:#F4E7D9;font-family:"EB Garamond",serif;letter-spacing:.08em;text-transform:uppercase;font-size:.68rem;vertical-align:middle}
</style>
