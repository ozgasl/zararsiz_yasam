---
import BaseLayout from "../layouts/BaseLayout.astro";
import Duyurular from "../components/Duyurular.astro";
import { slugify } from "../utils.js";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { join } from "node:path";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const latest = posts.slice(0, 3);
const base = import.meta.env.BASE_URL;

// Buluşmalar kartları admin panelindeki "Buluşmalar" koleksiyonundan geliyor,
// böylece Melis'in CMS'e girdiği başlık/sıra/görünürlük buraya da yansıyor.
// Görsel eşlemesi ikon anahtarına göre yapılıyor (src/pages/bulusmalar.astro'daki ikon setiyle aynı).
const MEETUP_IMAGES: Record<string, string> = {
  kitap: "kitap-kulubu.png",
  yazi: "yazi-meditasyon.png",
  sohbet: "mindfulness-sohbetleri.png",
  sanat: "sanatsal-bulusmalar.png",
  ada: "kahvalti-yuruyus.png",
  mikrofon: "konuk-konusmacilar.png",
};
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const cat of post.data.categories ?? []) {
    const key = slugify(cat);
    categoryCounts.set(key, (categoryCounts.get(key) ?? 0) + 1);
  }
}

const meetups = (await getCollection("meetups", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((m, i) => {
    // Yazısı olan buluşmalar doğrudan kendi kategori arşivine, henüz yazısı
    // olmayanlar Buluşmalar sayfasındaki açıklamasına gider.
    const catSlug = m.data.category ? slugify(m.data.category) : null;
    const hasPosts = catSlug ? (categoryCounts.get(catSlug) ?? 0) > 0 : false;
    return {
      slug: m.slug,
      title: m.data.title,
      image: MEETUP_IMAGES[m.data.icon] ?? "kitap-kulubu.png",
      alt: i % 2 === 1,
      href: hasPosts ? `${base}kategori/${catSlug}/` : `${base}bulusmalar/#${m.slug}`,
    };
  });

// scripts/fetch-youtube.mjs tarafından build öncesi üretilir (varsa).
// Dosya yoksa (ör. YOUTUBE_CHANNEL_ID henüz tanımlı değilse) sabit banner'a düşer.
let latestVideo = null;
try {
  const p = join(process.cwd(), "src/data/youtube-latest.json");
  latestVideo = JSON.parse(readFileSync(p, "utf-8"));
} catch {
  latestVideo = null;
}
---
<BaseLayout>


<!-- HERO -->
<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal">
      <h1>Farkındalıkla öze dönüş yolculuğuna hoş geldiniz</h1>
      <p class="lead">Mindfulness, meditasyon ve yin yoga ekseninde bilinçli bir yaşam için profesyonel çalışmalar, makaleler ve buluşmalar.</p>
      <div class="hero-actions">
        <a class="btn btn-outline" href={`${base}hakkimda/`}>Ben Kimim →</a>
        <a class="btn btn-outline" href={`${base}kitap/`}>İlk Kitabım →</a>
        <a class="btn btn-primary" href={`${base}birlikte-calisalim/`}>Birlikte Çalışalım →</a>
      </div>
    </div>
    <div class="hero-media reveal">
      <div class="hero-photo">
        <picture>
          <source
            type="image/webp"
            srcset={`${base}assets/img/buyukada-melis.webp 396w, ${base}assets/img/buyukada-melis@2x.webp 792w`}
            sizes="(max-width: 900px) 360px, 420px"
          />
          <img
            src={`${base}assets/img/buyukada-melis.jpg`}
            srcset={`${base}assets/img/buyukada-melis.jpg 396w, ${base}assets/img/buyukada-melis@2x.jpg 792w`}
            sizes="(max-width: 900px) 360px, 420px"
            width="396"
            height="607"
            alt="Melis Zararsız, Büyükada"
          />
        </picture>
      </div>
      <div class="pullquote">
        <span class="q">&ldquo;</span>
        <p>Yavaşlamak, esenlikli bir yaşam için insanın kendine vereceği en güzel hediye…</p>
      </div>
    </div>
  </div>
</section>

<!-- BOOK -->
<section class="book">
  <div class="wrap">
    <div class="book-panel reveal">
      <div class="book-cover">
        <div class="book-badge">Kitap</div>
        <img src={`${base}assets/img/kabuk-kapak.jpg`} alt="Kabuk kitabı kapağı">
      </div>
      <div class="book-body">
        <p class="eyebrow">Bir Dönüşüm Hikayesi</p>
        <h2>Kabuk</h2>
        <p>Geçmişinin yüklerinin altında kaldığını hisseden, kabuğunu yerinden oynatmaya cesaret eden bir kadının şeffaf ve dönüşmeye devam eden yolculuğu.</p>
        <div class="book-actions">
          <span class="badge-soon">Yakında</span>
          <a class="txtlink" href={`${base}kitap/`}>Kitap Hakkında →</a>
          <a class="txtlink" href={`${base}bulusmalar/#konuk-konusmacilar`}>İmza Günleri →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DUYURULAR (kayan bant — duyuru yoksa hiç görünmez) -->
<Duyurular variant="band" />

<!-- WHY -->
<section class="why">
  <div class="wrap">
    <h2 class="reveal">Neden Zararsız Yaşam?</h2>
    <p class="intro reveal">Soyadım Zararsız ve yıllarca bu kelimeyle pek de barışık yaşadığım söylenemez. İyi yaşama dair merakım ve aldığım eğitimler arttıkça kadim bilgilerde bile bu kelimeyle karşılaştım. Kendimize ve çevremize zarar vermeden; bilinçle, farkındalıkla, zarafetle yaşamanın önemini anladım. Bu alanı açarak kendimizle ve hayatla sahici bir ilişki kurmak için bir araya geliyoruz.</p>
    <div class="services">
      <div class="service reveal">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 8c3 0 5 2 7 4M19 8c-3 0-5 2-7 4"/></svg></div>
        <h3>Mindfulness Temelli Koçluk</h3>
        <p>Profesyonel koçluk seanslarında birebir çalışmalar ile hayatının tüm alanlarına daha bilinçli bir yaklaşımla bakmak isteyenler için açılan bir alan.</p>
        <a class="txtlink" href={`${base}birlikte-calisalim/mindfulness-koclugu/`}>Detaylar →</a>
      </div>
      <div class="service reveal">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 20c1-4 4-6 7-6s6 2 7 6"/></svg></div>
        <h3>Yin Yoga</h3>
        <p>Profesyonel yin yoga derslerinde birebir ya da grup halinde bağ dokularımız üzerine çalışmalar; yavaşlamak, beden, zihin ve ruhu yeniden hizalamak için.</p>
        <a class="txtlink" href={`${base}birlikte-calisalim/yin-yoga/`}>Detaylar →</a>
      </div>
      <div class="service reveal">
        <div class="svc-ico"><svg viewBox="0 0 24 24"><path d="M12 4c4 3 4 9 0 16C8 13 8 7 12 4Z"/><path d="M12 12h0"/></svg></div>
        <h3>Meditasyon</h3>
        <p>Düzenli pratikler, grup ve bireysel seanslar, yönlendirmeler. Zihni sakinleştirmek ve ana dönmek için sürdürülebilir bir alan.</p>
        <a class="txtlink" href={`${base}birlikte-calisalim/meditasyon/`}>Detaylar →</a>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIAL + MEETUPS -->
<section class="mid">
  <div class="wrap">
    <div class="mid-row reveal">
      <div class="mid-card testi-teaser">
        <p class="eyebrow">Katılımcılardan Gelenler</p>
        <p>&ldquo;Büyükada'ya olan sevgim sayesinde yollarımız kesişti... Kendi gelişim yolculuğumda bana ilham veren, bakış açımı genişleten ve destekleyen biri.&rdquo; — Yeliz</p>
        <a class="txtlink" href={`${base}bonservisler/`} style="color:#F4E7D9">Tüm Yorumlar →</a>
      </div>
      <div class="mid-card banner-frame">
        <p class="banner-title">Son Videom</p>
        {latestVideo ? (
          <a class="banner-media" href={latestVideo.url} target="_blank" rel="noopener" aria-label={latestVideo.title || "Zararsız Yaşam YouTube kanalı"}>
            <img src={latestVideo.thumbnail} alt={latestVideo.title || "Zararsız Yaşam son video"} loading="lazy">
          </a>
        ) : (
          <a class="banner-media" href="https://www.youtube.com/c/zararsizyasam" target="_blank" rel="noopener" aria-label="Zararsız Yaşam YouTube kanalı">
            <img src={`${base}assets/img/youtube-banner.jpg`} alt="Zararsız Yaşam YouTube kanalı">
          </a>
        )}
      </div>
      <div class="mid-card banner-frame">
        <p class="banner-title">Son Podcast Yayınım</p>
        <iframe class="podcast-embed" src="https://open.spotify.com/embed/show/3nRY5vcYONoctjQOAs4J9J?utm_source=generator" width="100%" height="152" frameborder="0" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" title="Zararsız Yaşam Podcast"></iframe>
      </div>
    </div>
    <div class="meet reveal">
      <div class="meet-head">
        <h2>Buluşmalar</h2>
        <a class="txtlink" href={`${base}bulusmalar/`}>Tüm Buluşmalar →</a>
      </div>
      <div class="meet-grid">
        {meetups.map((m) => (
          <a class="meet-card" href={m.href}>
            <div class={`ph${m.alt ? " alt" : ""}`}><img src={`${base}assets/img/bulusmalar/${m.image}`} alt={m.title} loading="lazy"></div>
            <div class="label">{m.title}</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- BLOG -->
<section class="lower">
  <div class="wrap">
    <div class="reveal">
      <div class="blog-head">
        <h2>Blog Yazıları</h2>
        <a class="txtlink" href={`${base}blog/`}>Tüm Yazılar →</a>
      </div>
      
<div class="posts posts-3">
        {latest.map((p) => (
          <article class="post">
            <div class="ph">{p.data.cover ? <img src={`${base}${p.data.cover.replace(/^\//, "")}`} alt={p.data.title} loading="lazy"> : <svg viewBox="0 0 24 24"><path d="M4 16c4-2 5-7 5-10 3 2 6 6 6 10"/></svg>}</div>
            <span class="cat">{p.data.categories?.[0] ?? "Yazı"}</span>
            <h3>{p.data.title}</h3>
            <a class="txtlink" href={`${base}blog/${p.slug}/`}>Devamı →</a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->

</BaseLayout>
