---
import "../styles/global.css";
import { metinler } from "../site.js";
const { title = "Zararsız Yaşam — Melis Zararsız", description = "Mindfulness temelli koçluk, yin yoga ve meditasyon ekseninde bilinçli bir yaşam için çalışmalar, yazılar ve buluşmalar." } = Astro.props;
const base = import.meta.env.BASE_URL;
const alt = metinler.altbilgi;
---
<!DOCTYPE html>
<html lang="tr">
<head>
<script is:inline>document.documentElement.className='js'</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light" />

<!-- Google Analytics (GA4). Sadece canlı sitede yüklenir: önizleme
     (ozgasl.github.io) ve localhost ölçüme dahil olmasın. -->
<script is:inline>
  (function () {
    var live = ["meliszararsiz.com", "www.meliszararsiz.com"];
    if (live.indexOf(location.hostname) === -1) return;
    var id = "G-VX69C5SQB8";
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", id);
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
<header>
  <div class="wrap nav">
    <a class="brand" href={base} aria-label="Zararsız Yaşam">
      <img class="brand-logo" src={`${base}assets/img/logo.png`} alt="Zararsız Yaşam">
    </a>
    <nav>
      <ul class="menu" id="menu">
        <li><a href={`${base}hakkimda/`}>Hakkımda</a></li>
        <li><a href={`${base}birlikte-calisalim/`}>Birlikte Çalışalım</a></li>
        <li><a href={`${base}bulusmalar/`}>Buluşmalar</a></li>
        <li><a href={`${base}blog/`}>Blog Yazıları</a></li>
        <li><a href={`${base}kitap/`}>Kitap</a></li>
        <li><a href={`${base}bonservisler/`}>Bonservisler</a></li>
        <li><a href={`${base}iletisim/`}>İletişim</a></li>
      </ul>
    </nav>
    <button class="burger" id="burger" aria-label="Menü"><span></span><span></span><span></span></button>
  </div>
</header>
<main>
<slot />
</main>
<footer>
  <div class="wrap foot">
    <div class="foot-col foot-brand">
      <a class="brand" href={base} aria-label="Zararsız Yaşam">
        <img class="brand-logo foot-logo" src={`${base}assets/img/logo.png`} alt="Zararsız Yaşam">
      </a>
    </div>
    <div class="foot-col">
      <h4>Hızlı Erişim</h4>
      <ul>
        <li><a href={`${base}hakkimda/`}>Hakkımda</a></li>
        <li><a href={`${base}birlikte-calisalim/`}>Birlikte Çalışalım</a></li>
        <li><a href={`${base}bulusmalar/`}>Buluşmalar</a></li>
        <li><a href={`${base}blog/`}>Blog Yazıları</a></li>
        <li><a href={`${base}kitap/`}>Kitap</a></li>
        <li><a href={`${base}bonservisler/`}>Bonservisler</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h4>İletişim</h4>
      <ul>
        <li><a href={`mailto:${alt.eposta}`}>{alt.eposta}</a></li>
        <li><a href={alt.instagram_link} target="_blank" rel="noopener">{alt.instagram_etiket}</a></li>
        <li><a href={alt.spotify_link} target="_blank" rel="noopener">{alt.spotify_etiket}</a></li>
        <li><a href={alt.youtube_link} target="_blank" rel="noopener">{alt.youtube_etiket}</a></li>
      </ul>
      <div class="social">
        <a href={alt.instagram_link} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a href={alt.spotify_link} target="_blank" rel="noopener" aria-label="Spotify"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M7.5 10c3-1 6-.6 8.5.8M8 13c2.3-.7 4.7-.4 6.7.7M8.5 16c1.7-.5 3.5-.3 5 .5"/></svg></a>
        <a href={alt.youtube_link} target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M11 9.5l4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg></a>
        <a href={`mailto:${alt.eposta}`} aria-label="E-posta"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></a>
      </div>
    </div>
  </div>
  <div class="legal">{alt.telif}</div>
</footer>
<script is:inline>
  (function() {
    var els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach(function(el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    els.forEach(function(el) { io.observe(el); });
  })();
  (function() {
    // Bir bölüme link ile gelindiğinde (#kitap-kulubu gibi), o bölüm hemen
    // görünür olsun ve görseller yüklenip sayfa yüksekliği değiştikten sonra
    // doğru konuma tekrar kaydırılsın (scroll-behavior:smooth + gecikmeli
    // görsel yüklemeleri ilk kaymayı bozabiliyor).
    if (!location.hash) return;
    var target;
    try { target = document.querySelector(location.hash); } catch (e) { return; }
    if (!target) return;
    target.classList.add('in');
    function jump() { target.scrollIntoView({ block: 'start' }); }
    jump();
    window.addEventListener('load', jump);
    setTimeout(jump, 400);
  })();
  (function() {
    var burger = document.getElementById('burger');
    var menu = document.getElementById('menu');
    if (!burger || !menu) return;
    burger.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    menu.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') {
        menu.classList.remove('open');
        burger.classList.remove('open');
      }
    });
  })();
</script>
</body>
</html>
