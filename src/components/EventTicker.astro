---
// Söyleşiler ve İmza Günleri kayan bandı.
// CMS'te "Etkinlikler" koleksiyonundan besleniyor (public/admin/config.yml).
import { getCollection } from "astro:content";

interface Props {
  variant?: "full" | "compact";
  limit?: number;
}
const { variant = "full", limit } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const now = new Date();
now.setHours(0, 0, 0, 0);

const all = (await getCollection("events", ({ data }) => !data.draft))
  .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

const upcoming = all.filter((e) => new Date(e.data.date) >= now);
const events = typeof limit === "number" ? upcoming.slice(0, limit) : upcoming;

const dateFmt = (d: Date) =>
  new Date(d).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" });
---

{events.length === 0 ? (
  <div class={`et et-empty et-${variant}`}>
    <span class="q">&ldquo;</span>
    <p>Yaklaşan söyleşiler, imza günleri ve kitap kulübü buluşmaları için duyurular yakında.</p>
  </div>
) : (
  <div class={`et et-${variant}`}>
    <div class="et-track" class:list={[{ "et-scroll": events.length > 2 }]}>
      {[...events, ...(events.length > 2 ? events : [])].map((e) => (
        <div class="et-card">
          <span class="et-date">{dateFmt(e.data.date)}</span>
          <h3>{e.data.title}</h3>
          {e.data.location && <span class="et-loc">{e.data.location}</span>}
          {e.data.link && (
            <a class="txtlink et-link" href={e.data.link} target="_blank" rel="noopener">Detaylar →</a>
          )}
        </div>
      ))}
    </div>
  </div>
)}

<style>
.et { overflow: hidden; }
.et-empty { text-align: center; }
.et-empty p { font-family: "Cormorant Garamond", serif; font-size: 1.3rem; color: inherit; }
.et-track { display: flex; gap: 20px; }
.et-full .et-track { padding: 4px 0; }
.et-scroll { width: max-content; animation: et-marquee 32s linear infinite; }
.et:hover .et-scroll { animation-play-state: paused; }
.et-card {
  flex: 0 0 auto;
  min-width: 240px;
  max-width: 280px;
  background: var(--cream2, #F4E7D9);
  border: 1px solid var(--line, #E4D6C4);
  border-radius: 16px;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.et-compact .et-card {
  background: transparent;
  border: 1px solid rgba(244,238,226,.25);
}
.et-date { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--wine, #5C1F2A); font-weight: 600; }
.et-compact .et-date { color: #E9C9B8; }
.et-card h3 { font-family: "Cormorant Garamond", serif; font-size: 1.25rem; margin: 2px 0 0; }
.et-loc { font-size: .9rem; color: var(--muted, #7A7264); }
.et-link { margin-top: 6px; }
@keyframes et-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .et-scroll { animation: none; }
}
</style>
